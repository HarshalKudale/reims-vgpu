<Application x:Class="ReimsManager.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ThemeMode="System">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}"><Setter Property="Padding" Value="16,8"/><Setter Property="Margin" Value="0,0,8,8"/></Style>
      <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
